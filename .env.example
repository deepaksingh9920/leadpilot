# LeadPilot — example environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# All values below are placeholders.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# Local development uses SQLite. For staging/production use Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/leadpilot?sslmode=require"
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-32-byte-random-string
SESSION_COOKIE_NAME=leadpilot_session

# ── Background worker / scheduler ───────────────────────────────────────────
WORKER_SECRET=replace-with-a-random-worker-secret
CRON_SECRET=replace-with-a-random-cron-secret
WORKER_LEASE_SECONDS=600
WORKER_MAX_ATTEMPTS=3
# Enable only after configuring an AI provider and a lead source. While false,
# queued jobs stay queued and no provider is called.
AGENT_RUNTIME_READY=false

# ── AI model (required for research and qualification) ─────────────────────
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2000

# ── Lead data sources (choose a primary; keep only what you have contracts for) ──
# Leave blank or set to csv to use the single configured API key automatically.
# Set to apollo, pdl, or google_places to choose explicitly when several keys exist.
PRIMARY_LEAD_SOURCE=
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/v1
PDL_API_KEY=
PDL_API_BASE_URL=https://api.peopledatalabs.com/v5
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1
# Optional terms overrides stored with sourced leads and shown on Integrations.
APOLLO_TERMS_URL=
PDL_TERMS_URL=
GOOGLE_PLACES_TERMS_URL=

# ── Email outreach (required before any sending is enabled) ─────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Your Company <outreach@example.com>"
EMAIL_REPLY_TO=sales@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OUTREACH_DAILY_CAP_DEFAULT=50

# ── Razorpay billing (test mode for staging) ──────────────────────────────────
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# ── Security ────────────────────────────────────────────────────────────────
# 32-byte base64 key used to encrypt per-workspace integration credentials.
INTEGRATION_ENCRYPTION_KEY=
RATE_LIMIT_WINDOW_SECONDS=900

# ── First-run superadmin (seed only; change the password after login) ──────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# ── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# LeadPilot — example environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# All values below are placeholders.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# Local development uses SQLite. For staging/production use Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/leadpilot?sslmode=require"
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-32-byte-random-string
SESSION_COOKIE_NAME=leadpilot_session

# ── Background worker / scheduler ───────────────────────────────────────────
WORKER_SECRET=replace-with-a-random-worker-secret
CRON_SECRET=replace-with-a-random-cron-secret
WORKER_LEASE_SECONDS=600
WORKER_MAX_ATTEMPTS=3

# ── AI model (required for research, scoring rationale, outreach drafts) ────
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2000

# ── Lead data sources (choose a primary; keep only what you have contracts for) ──
PRIMARY_LEAD_SOURCE=csv
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/v1
PDL_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# ── Email outreach (required before any sending is enabled) ─────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Your Company <outreach@example.com>"
EMAIL_REPLY_TO=sales@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OUTREACH_DAILY_CAP_DEFAULT=50

# ── Stripe billing (test mode for staging) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# ── Security ────────────────────────────────────────────────────────────────
# 32-byte base64 key used to encrypt per-workspace integration credentials.
INTEGRATION_ENCRYPTION_KEY=
RATE_LIMIT_WINDOW_SECONDS=900

# ── First-run superadmin (seed only; change the password after login) ──────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# ── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
